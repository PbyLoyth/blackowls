---
const items = [
  { id: 'tempo', text: 'Haftada 2 maç.', more: 'Turnuva döneminde 4 ile 5.' },
  { id: 'tank', text: 'Yılda en fazla 2 turnuva.', more: 'Hedef her zaman final.' },
  { id: 'mac', text: 'OWI turnuvasına dahil olabilmiş', more: 'tek Türk takımı.' },
  { id: 'heli', text: '2018’den beri', more: '1.000’e yakın oyuncu.' },
  { id: 'strike', text: 'Ciddi ve disiplinli.', more: 'Maçlar yoğun, gergin, unutulmaz.' },
];
---

<section class="hl" aria-labelledby="hl-title" data-gallery>
  <div class="w hl__head">
    <h2 class="title" id="hl-title" data-fade>Öne çıkanlar.</h2>
    <button class="more" type="button" data-trailer>Fragmanı izle</button>
  </div>

  <div class="hl__track" data-track tabindex="0" aria-label="Öne çıkanlar galerisi">
    {
      items.map((item) => (
        <figure class="tile" data-item>
          <img src={`/media/${item.id}.webp`} alt="" width="1280" height="720" loading="lazy" decoding="async" />
          <video muted playsinline preload="none" aria-hidden="true" tabindex="-1">
            <source media="(max-width: 700px)" src={`/media/${item.id}-720.mp4`} type="video/mp4" />
            <source src={`/media/${item.id}.mp4`} type="video/mp4" />
          </video>
          <figcaption>
            <b>{item.text}</b>
            <span>{item.more}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>

  <div class="hl__ctl">
    <div class="dots" role="group" aria-label="Galeri konumu">
      {items.map((item, i) => (
        <button type="button" data-dot aria-label={`${i + 1}. kare`}><i></i></button>
      ))}
    </div>
    <button class="toggle" type="button" data-toggle aria-label="Galeriyi duraklat"><span></span></button>
  </div>
</section>

<style>
  .hl {
    background: var(--black);
    padding-bottom: var(--sec);
    overflow: hidden;
  }

  .hl__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 24px;
    margin-bottom: clamp(24px, 3.4vw, 44px);
  }

  .hl__track {
    --tile-w: min(calc(100vw - 2 * var(--gutter)), 1060px);
    display: flex;
    gap: clamp(12px, 1.6vw, 20px);
    padding-inline: calc((100vw - var(--tile-w)) / 2);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .hl__track::-webkit-scrollbar {
    display: none;
  }

  .hl__track:focus-visible {
    outline-offset: -4px;
  }

  .tile {
    position: relative;
    flex: 0 0 var(--tile-w);
    aspect-ratio: 16 / 9;
    border-radius: var(--r-l);
    overflow: hidden;
    background: var(--tile);
    scroll-snap-align: center;
    transform: translateZ(0);
  }

  .tile img,
  .tile video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tile::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 52%;
    background: linear-gradient(to bottom, rgb(0 0 0 / 0.72), rgb(0 0 0 / 0.4) 42%, rgb(0 0 0 / 0));
    pointer-events: none;
  }

  figcaption {
    position: absolute;
    z-index: 1;
    left: clamp(20px, 3.2vw, 40px);
    top: clamp(18px, 3vw, 36px);
    right: clamp(20px, 3.2vw, 40px);
    font-size: clamp(1.25rem, 2.6vw, 2rem);
    line-height: 1.14;
    letter-spacing: -0.024em;
    font-weight: 600;
  }

  figcaption b {
    display: block;
    font-weight: 600;
  }

  figcaption span {
    display: block;
    color: rgb(245 245 247 / 0.72);
  }

  .hl__ctl {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: clamp(16px, 2vw, 24px);
  }

  .dots {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 44px;
    padding-inline: 12px;
    border-radius: 980px;
    background: var(--tile-2);
  }

  .dots button {
    position: relative;
    width: 24px;
    height: 44px;
    transition: width 340ms var(--ease);
  }

  .dots i {
    position: absolute;
    left: 8px;
    right: 8px;
    top: 50%;
    height: 8px;
    margin-top: -4px;
    border-radius: 980px;
    background: var(--g3);
    overflow: hidden;
    transition: background-color 200ms ease;
  }

  .dots i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--paper);
    transform: scaleX(var(--fill, 0));
    transform-origin: left;
  }

  .dots button[data-on] {
    width: 56px;
  }

  .dots button[data-on] i {
    background: var(--g5);
  }

  .toggle {
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--tile-2);
    transition: background-color 160ms ease, transform 160ms var(--ease);
  }

  .toggle:active {
    transform: scale(0.94);
  }

  .toggle span,
  .toggle span::after {
    position: absolute;
    top: 16px;
    width: 3.5px;
    height: 12px;
    border-radius: 1px;
    background: var(--paper);
  }

  .toggle span {
    left: 17px;
  }

  .toggle span::after {
    content: '';
    top: 0;
    left: 7px;
  }

  .toggle[data-paused] span {
    left: 18px;
    width: 0;
    height: 0;
    top: 15px;
    border-radius: 0;
    background: none;
    border-block: 7px solid transparent;
    border-left: 11px solid var(--paper);
  }

  .toggle[data-paused] span::after {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .toggle:hover {
      background: #333336;
    }
  }

  @media (max-width: 700px) {
    .tile {
      aspect-ratio: 4 / 5;
    }
  }
</style>
