---
import { site, formatCount, ayarlar } from '../data/site.js';
import discord from '../data/discord.json';

const rules = [
  ['Kural 0', 'Temel ve en önemli kural: oyun kalitesi.'],
  ['Kural 1.5', 'TK sonrası all chat’e “Sorry TK” yaz.'],
  ['Kural 2.1', 'SL her zaman SL kiti ile oynar, mikrofon kullanır, Türkçe konuşur.'],
];
---

<section class="cage" id="kafes" aria-labelledby="kafes-title">
  <div class="w">
    <h2 class="title" id="kafes-title" data-fade>
      Kafes. <span data-ayar="basliklar.kafes">{ayarlar.basliklar.kafes}</span>
    </h2>

    <div class="bento">
      <article class="tile server" data-fade>
        <svg class="server__icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M1 1h18v18H1zM7 1v18M13 1v18M1 7h18M1 13h18" /></svg>
        <div class="server__head">
          <h3 class="sub">Sunucu bilgileri</h3>
          <p class="server__state" data-ayar-durum="kafes.acik" data-durum={site.server.open ? 'acik' : 'kapali'}>
            <i aria-hidden="true"></i><span data-ayar="kafes.durum">{site.server.status}</span>
          </p>
        </div>
        <div class="server__rows">
          <button class="copy" type="button" data-copy={site.server.name} data-ayar-ozellik="data-copy:kafes.ad">
            <span class="copy__body">
              <small>Sunucu adı</small>
              <code data-ayar="kafes.ad">{site.server.name}</code>
            </span>
            <span class="copy__tag" data-copy-label>Kopyala</span>
          </button>
          <button class="copy" type="button" data-copy={site.server.ip} data-ayar-ozellik="data-copy:kafes.ip">
            <span class="copy__body">
              <small>IP adresi</small>
              <code data-ayar="kafes.ip">{site.server.ip}</code>
            </span>
            <span class="copy__tag" data-copy-label>Kopyala</span>
          </button>
        </div>
      </article>

      <article class="tile disc" data-fade style="--d:80ms">
        <p class="disc__live"><i aria-hidden="true"></i> <span data-live="online">{formatCount(discord.online)}</span> çevrimiçi</p>
        <p class="disc__num" data-live="members">{formatCount(discord.members)}</p>
        <p class="disc__label">Discord üyesi. Her şey burada başlıyor.</p>
        <a class="pill" href={site.discord} target="_blank" rel="noopener">Discord’a gir</a>
      </article>

      {
        rules.map(([id, text], i) => (
          <article class="tile rule" data-fade style={`--d:${i * 60}ms`}>
            <p class="rule__id">{id}</p>
            <p class="rule__text">{text}</p>
          </article>
        ))
      }

      <article class="tile rulesall" data-fade style="--d:180ms">
        <h3 class="sub">Tüm kurallar</h3>
        <a class="more" href="/kurallar">Kuralları oku</a>
      </article>
    </div>
  </div>
</section>

<style>
  .cage {
    padding-block: calc(var(--sec) * 0.6) var(--sec);
    background: var(--black);
  }

  .cage .title {
    margin-bottom: clamp(32px, 4.6vw, 64px);
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(12px, 1.6vw, 20px);
  }

  .tile {
    position: relative;
    padding: clamp(22px, 2.8vw, 36px);
    border-radius: var(--r-l);
    background: var(--tile);
    overflow: hidden;
  }

  .server {
    grid-column: span 8;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 44px;
  }

  .server__icon {
    position: absolute;
    right: clamp(22px, 2.8vw, 36px);
    top: clamp(22px, 2.8vw, 36px);
    width: 34px;
    height: 34px;
    fill: none;
    stroke: var(--amber);
    stroke-width: 1.4;
  }

  .server__head {
    position: relative;
  }

  .server__state {
    display: flex;
    align-items: baseline;
    gap: 9px;
    margin-top: 8px;
    padding-right: 48px;
  }

  .server__state[data-durum='acik'] i {
    background: #30d158;
  }

  .server__state i {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--amber);
    transform: translateY(-1px);
  }

  .server__rows {
    position: relative;
    display: grid;
    gap: 8px;
  }

  .copy {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    width: 100%;
    padding: 11px 12px 11px 16px;
    border-radius: 14px;
    background: var(--tile-2);
    text-align: left;
    transition: background-color 160ms ease, transform 160ms var(--ease);
  }

  .copy:active {
    transform: scale(0.99);
  }

  .copy__body {
    display: grid;
    min-width: 0;
  }

  .copy small {
    color: var(--g3);
    font-size: 0.8125rem;
  }

  .copy code {
    overflow-wrap: anywhere;
    font-family: var(--mono);
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
  }

  .copy__tag {
    flex: none;
    min-width: 78px;
    padding: 6px 12px;
    border-radius: 980px;
    background: rgb(255 255 255 / 0.1);
    color: var(--paper);
    font-size: 0.8125rem;
    font-weight: 500;
    text-align: center;
    transition: background-color 160ms ease, color 160ms ease;
  }

  .copy__tag[data-done] {
    background: var(--amber);
    color: var(--black);
  }

  @media (hover: hover) and (pointer: fine) {
    .copy:hover {
      background: #2c2c2e;
    }
  }

  .disc {
    grid-column: span 4;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .disc__live {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--g2);
    font-size: 0.9375rem;
  }

  .disc__live i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--amber);
    animation: pulse 2.4s ease-out infinite;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgb(255 159 10 / 0.6);
    }

    100% {
      box-shadow: 0 0 0 9px rgb(255 159 10 / 0);
    }
  }

  .disc__num {
    margin-top: auto;
    padding-top: 28px;
    font-size: clamp(3.5rem, 6.6vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 600;
  }

  .disc__label {
    margin-block: 6px 18px;
    color: var(--g3);
  }

  .rule {
    grid-column: span 3;
    min-height: 208px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .rule__id {
    color: var(--amber);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .rule__text {
    font-size: 1.25rem;
    line-height: 1.22;
    letter-spacing: -0.018em;
    font-weight: 600;
  }

  .rulesall {
    grid-column: span 3;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .rulesall .sub {
    margin-bottom: auto;
    font-size: 1.5rem;
  }

  .rulesall .more {
    min-height: 34px;
  }

  @media (max-width: 960px) {
    .server,
    .disc {
      grid-column: span 12;
    }

    .rule,
    .rulesall {
      grid-column: span 6;
    }

    .disc__num {
      padding-top: 18px;
    }
  }

  @media (max-width: 560px) {
    .rule,
    .rulesall {
      grid-column: span 12;
      min-height: 0;
    }

    .rulesall .sub {
      margin-bottom: 8px;
    }

    .server {
      gap: 28px;
    }
  }
</style>

<script>
  document.querySelectorAll('[data-copy]').forEach((btn) => {
    const label = btn.querySelector('[data-copy-label]');
    let timer;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy);
        label.textContent = 'Kopyalandı';
        label.setAttribute('data-done', '');
      } catch {
        label.textContent = 'Olmadı';
      }
      clearTimeout(timer);
      timer = setTimeout(() => {
        label.textContent = 'Kopyala';
        label.removeAttribute('data-done');
      }, 1600);
    });
  });
</script>
