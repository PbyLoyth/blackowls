---
import '@fontsource-variable/mona-sans/wght.css';
import '../styles/global.css';
import fontUrl from '@fontsource-variable/mona-sans/files/mona-sans-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, socials } from '../data/site.js';

const { title = site.title, description = site.description, noindex = false, theme = 'dark' } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, ''), site.url).href;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SportsTeam',
  name: site.name,
  url: site.url,
  logo: `${site.url}/icon-512.png`,
  description: site.description,
  sport: 'E-spor',
  foundingDate: '2018',
  email: site.email,
  sameAs: socials.map((s) => s.href),
};
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={theme === 'dark' ? '#000000' : '#ffffff'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}/og.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
      if ('WebGL2RenderingContext' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('gl');
      }
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <slot name="head" />
  </head>
  <body class={theme}>
    <a class="skip" href="#icerik">İçeriğe geç</a>
    <Header theme={theme} />
    <main id="icerik">
      <slot />
    </main>
    <Footer />
  </body>
</html>
